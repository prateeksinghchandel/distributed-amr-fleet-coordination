{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:sim": "node sim-smoke.test.mjs",
    "test:builder": "node test/warehouse-builder.test.mjs",
    "test:transport": "node transport.test.mjs",
    "test:distributed": "node test/distributed-fleet.test.mjs",
    "test:distributed-state": "node test/distributed-state.test.mjs",
    "test:phase5": "node test/phase5-python-fleet.test.mjs",
    "fleet": "bash scripts/start-fleet.sh",
    "fleet:stop": "bash scripts/start-fleet.sh --stop",
    "setup:zenoh": "node scripts/download-zenoh.mjs",
    "fleet-manager": "node scripts/run-fleet-manager.mjs",
    "rl-server": "node scripts/run-rl-server.mjs",
    "rl-server:league": "node scripts/run-rl-server.mjs --league --pool-size 4 --pool-every 3000",
    "rl-server:headless": "node scripts/run-rl-server.mjs --scenario dense_traffic --level 8 --n-envs 24",
    "rl:headless": "node scripts/run-rl-server.mjs headless --scenario dense_traffic --level 8 --steps 60000 --n-envs 24 --save-every 5000"
  },
  "dependencies": {
    "@eclipse-zenoh/zenoh-ts": "^1.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
